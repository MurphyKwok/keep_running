.detail-page {
  padding: 34rpx 28rpx 72rpx;
}

.detail-head {
  padding: 4rpx 4rpx 34rpx;
}

.detail-kicker,
.detail-city,
.metric-label,
.metric-unit,
.data-label,
.detail-note,
.track-badge {
  color: #818181;
  letter-spacing: 1rpx;
}

.detail-kicker {
  display: block;
  margin-bottom: 20rpx;
  color: #d9f42b;
  font-family: Menlo, monospace;
  font-size: 19rpx;
}

.detail-date {
  display: block;
  color: #f1f1ec;
  font-size: 31rpx;
  font-weight: 700;
}

.detail-city {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.distance-lockup {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
}

.distance-value {
  color: #f7f7f1;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 106rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -4rpx;
}

.distance-unit {
  margin-left: 14rpx;
  color: #d9f42b;
  font-size: 28rpx;
  font-weight: 700;
}

.map-card {
  position: relative;
  overflow: hidden;
  height: 570rpx;
  border: 1rpx solid #303030;
  border-radius: 24rpx;
  background: #171717;
}

.detail-map {
  width: 100%;
  height: 100%;
}

.detail-map-empty {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  color: #777;
  font-size: 24rpx;
}

.empty-route {
  color: #d9f42b;
  font-size: 80rpx;
}

.track-badge {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  padding: 10rpx 13rpx;
  border-radius: 7rpx;
  background: rgba(16, 16, 16, 0.84);
  flex-direction: column;
  gap: 3rpx;
  color: #d9f42b;
  font-family: Menlo, monospace;
  font-size: 15rpx;
  text-align: right;
  pointer-events: none;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid #2b2b2b;
  border-radius: 22rpx;
  background: #171717;
}

.metric-cell {
  display: flex;
  min-height: 148rpx;
  padding: 23rpx 20rpx;
  box-sizing: border-box;
  border-right: 1rpx solid #2b2b2b;
  border-bottom: 1rpx solid #2b2b2b;
  flex-direction: column;
  justify-content: center;
}

.metric-cell:nth-child(3n) {
  border-right: 0;
}

.metric-cell:nth-last-child(-n + 3) {
  border-bottom: 0;
}

.metric-featured {
  background: #1d2110;
}

.metric-label {
  font-size: 19rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #f3f3ed;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 35rpx;
  font-weight: 700;
}

.metric-featured .metric-value {
  color: #d9f42b;
}

.metric-unit {
  margin-top: 3rpx;
  font-family: Menlo, monospace;
  font-size: 16rpx;
}

.data-panel {
  margin-top: 24rpx;
  padding: 10rpx 28rpx;
  border: 1rpx solid #2b2b2b;
  border-radius: 20rpx;
  background: #171717;
}

.data-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #292929;
  font-size: 23rpx;
}

.data-row:last-child {
  border-bottom: 0;
}

.data-label {
  color: #777;
}

.data-value {
  color: #d6d6d0;
  font-family: Menlo, monospace;
  font-size: 21rpx;
}

.detail-note {
  display: block;
  margin: 28rpx 8rpx 0;
  color: #777;
  font-size: 21rpx;
  line-height: 1.7;
}

.not-found {
  display: flex;
  min-height: 100vh;
  padding: 80rpx 44rpx;
  box-sizing: border-box;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.not-found-code {
  color: #d9f42b;
  font-family: Menlo, monospace;
  font-size: 96rpx;
}

.not-found-title {
  margin-top: 20rpx;
  color: #eee;
  font-size: 28rpx;
}

.back-button {
  margin-top: 42rpx;
  padding: 0 32rpx;
  background: #d9f42b;
  color: #111;
  font-size: 24rpx;
}
