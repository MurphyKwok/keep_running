.home-page {
  padding: 28rpx 28rpx 72rpx;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 46rpx;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid #d9f42b;
  border-radius: 50%;
  box-sizing: border-box;
  color: #d9f42b;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.brand-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.brand-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand-subtitle,
.archive-count,
.eyebrow,
.section-kicker,
.stat-label,
.section-note,
.data-note {
  color: #818181;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  margin-top: 5rpx;
}

.archive-count {
  color: #d9f42b;
  font-family: 'SFMono-Regular', Menlo, monospace;
}

.hero {
  margin-bottom: 30rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #b1b1b1;
}

.hero-distance {
  display: flex;
  align-items: baseline;
  height: 104rpx;
}

.hero-value {
  color: #f7f7f2;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 100rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -5rpx;
}

.hero-unit {
  margin-left: 14rpx;
  color: #d9f42b;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-caption {
  color: #8d8d8d;
  font-size: 24rpx;
}

.year-scroll {
  width: 100%;
  margin: 30rpx 0 28rpx;
  white-space: nowrap;
}

.year-row {
  display: flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.year-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 22rpx;
  border: 1rpx solid #303030;
  border-radius: 999rpx;
  background: #171717;
  color: #aaa;
  font-size: 24rpx;
}

.year-chip-active {
  border-color: #d9f42b;
  background: #d9f42b;
  color: #111;
  font-weight: 700;
}

.year-count {
  min-width: 24rpx;
  opacity: 0.62;
  font-family: Menlo, monospace;
  font-size: 18rpx;
  text-align: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
  border: 1rpx solid #292929;
  border-radius: 22rpx;
  background: #171717;
}

.stat-cell {
  display: flex;
  min-height: 138rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
}

.stat-cell:nth-child(odd) {
  border-right: 1rpx solid #292929;
}

.stat-cell:nth-child(-n + 2) {
  border-bottom: 1rpx solid #292929;
}

.stat-value {
  color: #f5f5ef;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 7rpx;
  letter-spacing: 1rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 48rpx 2rpx 20rpx;
}

.section-kicker,
.section-title {
  display: block;
}

.section-kicker {
  margin-bottom: 5rpx;
  color: #d9f42b;
  font-family: Menlo, monospace;
  font-size: 18rpx;
}

.section-title {
  color: #f5f5ef;
  font-size: 34rpx;
  font-weight: 700;
}

.section-note {
  max-width: 370rpx;
  line-height: 1.5;
  text-align: right;
  letter-spacing: 0;
}

.map-shell {
  position: relative;
  overflow: hidden;
  height: 520rpx;
  border: 1rpx solid #303030;
  border-radius: 24rpx;
  background: #181818;
}

.run-map {
  width: 100%;
  height: 100%;
}

.map-empty {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  color: #777;
  font-size: 24rpx;
}

.empty-icon {
  color: #d9f42b;
  font-size: 74rpx;
}

.map-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 9rpx 13rpx;
  border-radius: 7rpx;
  background: rgba(16, 16, 16, 0.82);
  color: #d9f42b;
  font-family: Menlo, monospace;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  pointer-events: none;
}

.run-list {
  overflow: hidden;
  border: 1rpx solid #292929;
  border-radius: 22rpx;
  background: #171717;
}

.run-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  padding: 28rpx 52rpx 26rpx 28rpx;
  border-bottom: 1rpx solid #292929;
}

.run-card:last-child {
  border-bottom: 0;
}

.run-card-hover {
  background: #202020;
}

.run-main {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.run-date {
  color: #f2f2ee;
  font-size: 27rpx;
  font-weight: 650;
}

.run-city {
  overflow: hidden;
  margin-top: 8rpx;
  color: #777;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.run-distance {
  display: flex;
  align-items: baseline;
}

.run-distance-value {
  color: #f3f3eb;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 36rpx;
  font-weight: 750;
}

.run-distance-unit {
  margin-left: 6rpx;
  color: #747474;
  font-size: 19rpx;
}

.run-meta {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 20rpx;
  color: #8b8b8b;
  font-family: Menlo, monospace;
  font-size: 19rpx;
}

.gps-tag {
  padding: 4rpx 7rpx;
  border: 1rpx solid #52610a;
  border-radius: 5rpx;
  color: #bbd51d;
  font-size: 15rpx;
}

.gps-tag-off {
  border-color: #383838;
  color: #666;
}

.run-heart {
  position: absolute;
  bottom: 25rpx;
  right: 28rpx;
  color: #c7c7c1;
  font-family: Menlo, monospace;
  font-size: 19rpx;
}

.run-chevron {
  position: absolute;
  top: 38rpx;
  right: 24rpx;
  color: #545454;
  font-size: 40rpx;
  line-height: 1;
}

.more-button {
  height: 78rpx;
  margin: 24rpx 0 0;
  border: 1rpx solid #343434;
  border-radius: 16rpx;
  background: #171717;
  color: #d9f42b;
  font-size: 25rpx;
  line-height: 78rpx;
}

.more-button::after {
  border: 0;
}

.list-end,
.data-note {
  display: block;
  margin-top: 28rpx;
  text-align: center;
}

.data-note {
  margin-top: 34rpx;
  line-height: 1.6;
  letter-spacing: 0;
}
